#!/usr/bin/env python3
"""Hook Claude Code -> état de l'agent pour WezTerm.

Écrit $XDG_STATE_HOME/wezterm-agents/<WEZTERM_PANE>.json, lu par agents.lua.
États : idle, working, waiting (confirmation / question), done (tour terminé).
Ne doit jamais faire échouer Claude : toujours exit 0, rien sur stdout.
"""
import json
import os
import sys
import time

pane = os.environ.get("WEZTERM_PANE")
if not pane:
    sys.exit(0)

state_dir = os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
    "wezterm-agents",
)
path = os.path.join(state_dir, f"{pane}.json")


def short(text, n=140):
    text = " ".join(str(text or "").split())
    return text if len(text) <= n else text[: n - 1] + "…"


def last_assistant_text(data):
    if data.get("last_assistant_message"):
        return data["last_assistant_message"]
    tp = data.get("transcript_path")
    if not tp or not os.path.exists(tp):
        return ""
    try:
        with open(tp, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 300_000))
            lines = f.read().decode("utf-8", "ignore").splitlines()
        for line in reversed(lines):
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            if entry.get("type") != "assistant":
                continue
            content = entry.get("message", {}).get("content", [])
            texts = [c.get("text", "") for c in content if isinstance(c, dict) and c.get("type") == "text"]
            if any(texts):
                return " ".join(texts)
    except OSError:
        pass
    return ""


def main():
    try:
        data = json.load(sys.stdin)
    except ValueError:
        data = {}
    event = data.get("hook_event_name", "")

    if event == "SessionEnd":
        try:
            os.remove(path)
        except FileNotFoundError:
            pass
        return

    try:
        with open(path) as f:
            current = json.load(f)
    except (OSError, ValueError):
        current = {}

    state, message = None, None
    if event == "SessionStart":
        state, message = "idle", ""
        current.pop("task", None)
    elif event == "UserPromptSubmit":
        state, message = "working", ""
        if not current.get("task"):
            current["task"] = short(data.get("prompt"), 80)
    elif event == "PreToolUse":
        if data.get("tool_name") == "AskUserQuestion":
            qs = data.get("tool_input", {}).get("questions") or [{}]
            state, message = "waiting", "Question : " + short(qs[0].get("question"))
        else:
            state, message = "working", ""
    elif event in ("PostToolUse", "PostToolUseFailure"):
        state, message = "working", ""
    elif event == "PermissionRequest":
        state, message = "waiting", "Permission : " + short(data.get("tool_name"))
    elif event == "Notification":
        kind = data.get("notification_type", "")
        if kind in ("permission_prompt", "elicitation_dialog"):
            state, message = "waiting", short(data.get("message"))
        else:
            return  # idle_prompt & co : on garde l'état « done »
    elif event == "Stop":
        state, message = "done", short(last_assistant_text(data)) or "Tour terminé"
    else:
        return

    current.update(
        state=state,
        message=message,
        cwd=data.get("cwd") or current.get("cwd", ""),
        session_id=data.get("session_id") or current.get("session_id", ""),
        # Socket de l'instance WezTerm propriétaire du panneau (gui-sock-<pid>) :
        # les ids de panneau n'ont de sens que pour cette instance.
        socket=os.environ.get("WEZTERM_UNIX_SOCKET", ""),
        ts=int(time.time()),
    )
    os.makedirs(state_dir, exist_ok=True)
    tmp = f"{path}.tmp"
    with open(tmp, "w") as f:
        json.dump(current, f, ensure_ascii=False)
    os.replace(tmp, path)


try:
    main()
except Exception:  # noqa: BLE001 — un hook cassé ne doit jamais bloquer l'agent
    pass
sys.exit(0)
